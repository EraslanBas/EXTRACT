# ---- Large data artifacts ----
# data/ and results/ now live under $EXTRACT_ROOT on large_storage
# (see docs/data_layout.md); these entries guard against re-creating them here.
# NOTE the leading slash: an unanchored `data/` matches a directory of that name
# at ANY depth, which silently untracked the whole src/extract/data/
# source package. Keep these anchored to the repo root.
/data/
/results/
de_benchmark/
SRC/DATA/
SRC/results/
SRC/tmp/
SRC/DE_experiments/
MOFA/

# ---- Vendored third-party clones (have their own .git) ----
external/
MuVI/
SRC/ashr/

# ---- Binary / heavy formats ----
*.h5ad
*.hdf5
*.h5
*.pkl
*.parquet
*.npy
*.npz
SRC/SimulatedData_degs_sf.csv

# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.venv/

# ---- Downloadable reference data (NCBI/GO) ----
SRC/go_data/
reference/go_data/

# ---- LaTeX build artifacts ----
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
docs/paper/*.png

# ---- Documentation build ----
docs/_build/

# ---- Local tooling and one-off operational files ----
.claude/
.pytest_cache/
notebooks/untitled.txt
docs/HANDOFF.md
scripts/augment_after_matrix.sh
scripts/build_matrices_when_ready.sh
scripts/finish_jte607.sh
scripts/resume_after_orphans.sh
scripts/launch_e500.sh

# ---- Method paper: kept local, not part of the repository ----
docs/paper/
